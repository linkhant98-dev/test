
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow get, list, create, update, delete: if request.auth.uid == userId;
    }

    match /raw_materials/{id} { allow read, write: if isSignedIn(); }
    match /finished_goods/{id} { 
      allow read, write: if isSignedIn(); 
      match /bom_versions/{bomId} { allow read, write: if isSignedIn(); }
    }
    match /warehouses/{id} { 
      allow read, write: if isSignedIn(); 
      match /stock_transactions/{tid} { allow read, write: if isSignedIn(); }
    }
    match /waste_reasons/{id} { allow read, write: if isSignedIn(); }
    match /production_orders/{id} { 
      allow read, write: if isSignedIn(); 
      match /consumption_records/{cid} { allow read, write: if isSignedIn(); }
      match /output_records/{oid} { allow read, write: if isSignedIn(); }
    }
    
    match /customers/{id} { allow read, write: if isSignedIn(); }
    match /invoices/{id} { allow read, write: if isSignedIn(); }
  }
}
