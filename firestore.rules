
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Global settings: Read by anyone, written by admins
    match /appSettings/global {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Admin role verification
    match /roles_admin/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid);
      allow list: if isSignedIn();
    }

    // User directory: Full access for authenticated staff
    match /users/{userId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    // Audit logs: Read and create allowed for staff
    match /system_logs/{id} {
      allow read, create: if isSignedIn();
    }

    // Roles and Permissions: Read/Write for authenticated staff
    match /system_roles/{id} {
      allow read, write: if isSignedIn();
    }

    // Master Data Collections
    match /raw_materials/{id} {
      allow read, write: if isSignedIn();
    }
    match /finished_goods/{id} {
      allow read, write: if isSignedIn();
      
      match /price_rules/{ruleId} {
        allow read, write: if isSignedIn();
      }
      match /bom_versions/{bomId} {
        allow read, write: if isSignedIn();
      }
    }
    
    match /customers/{id} {
      allow read, write: if isSignedIn();
    }
    match /outlets/{id} {
      allow read, write: if isSignedIn();
    }
    match /warehouses/{id} {
      allow read, write: if isSignedIn();
      
      match /stock_transactions/{txnId} {
        allow read, write: if isSignedIn();
      }
    }

    // Operational Collections
    match /invoices/{id} {
      allow read, write: if isSignedIn();
    }
    match /outlet_sales/{id} {
      allow read, write: if isSignedIn();
    }
    match /expenses/{id} {
      allow read, write: if isSignedIn();
    }
    match /production_orders/{id} {
      allow read, write: if isSignedIn();
      
      match /consumption_records/{recId} {
        allow read, write: if isSignedIn();
      }
    }
    match /waste_reasons/{id} {
      allow read, write: if isSignedIn();
    }
    match /stock_transfers/{id} {
      allow read, write: if isSignedIn();
    }
  }
}
