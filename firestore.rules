/**
 * Core Philosophy:
 * This ruleset implements a robust Role-Based Access Control (RBAC) and Attribute-Based Access Control (ABAC) 
 * system for the Cheesy Bites Inventory Control & BOM Variance System. It prioritizes "Authorization 
 * Independence" by utilizing denormalized fields and dedicated role-check collections to minimize 
 * expensive cross-document lookups.
 *
 * Data Structure:
 * - /users/{userId}: Private user profiles accessible only by the owner.
 * - /{role}_users/{userId}: Marker collections (Admin, Master Data Manager, etc.) where the presence 
 *   of a UID-keyed document grants specific system-wide permissions.
 * - /raw_materials, /finished_goods, /warehouses, /waste_reasons: Master data collections managed 
 *   by Master Data Managers.
 * - /production_orders, /stock_transactions: Transactional data trees secured by operational roles.
 *
 * Key Security Decisions:
 * - DBAC (Document-Based Access Control): Roles are verified using `exists()` checks against 
 *   specialized collections, providing a scalable alternative to custom claims.
 * - Path-to-Data Consistency: For user-owned data, rules enforce that internal ID fields match 
 *    the path parameters during creation and remain immutable during updates.
 * - Prototyping Flexibility: While authorization is strictly enforced based on roles and ownership, 
 *   specific data field types and non-relational schemas are not validated to allow for rapid iteration.
 * - Backend-Only Entities: Insights and Variances are marked as read-only for users, as they are 
 *   intended to be populated by automated backend processes.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // Role-Based Access Helpers
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }

    function isMasterDataManager() {
      return isSignedIn() && (exists(/databases/$(database)/documents/master_data_manager_users/$(request.auth.uid)) || isAdmin());
    }

    function isInventoryManager() {
      return isSignedIn() && (exists(/databases/$(database)/documents/inventory_manager_users/$(request.auth.uid)) || isAdmin());
    }

    function isProductionManager() {
      return isSignedIn() && (exists(/databases/$(database)/documents/production_manager_users/$(request.auth.uid)) || isAdmin());
    }

    function isProductionOperator() {
      return isSignedIn() && (exists(/databases/$(database)/documents/production_operator_users/$(request.auth.uid)) || isAdmin());
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for user profiles. Users can only manage their own data.
     * @path /users/{userId}
     * @allow get, list, create, update, delete if request.auth.uid == userId
     * @deny create if request.auth.uid != userId
     * @principle Ownership-based access control.
     */
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update, delete: if isExistingOwner(userId);
    }

    /**
     * @description Role assignment collections. Only Admins can view or modify role assignments.
     * @path /{role_collection}/{userId}
     * @allow read, write if isAdmin()
     * @deny write if !isAdmin()
     * @principle Restricted administrative access for role management.
     */
    match /admin_users/{userId} {
      allow get, list, create, update, delete: if isAdmin();
    }
    match /master_data_manager_users/{userId} {
      allow get, list, create, update, delete: if isAdmin();
    }
    match /inventory_manager_users/{userId} {
      allow get, list, create, update, delete: if isAdmin();
    }
    match /production_manager_users/{userId} {
      allow get, list, create, update, delete: if isAdmin();
    }
    match /production_operator_users/{userId} {
      allow get, list, create, update, delete: if isAdmin();
    }

    /**
     * @description Master data (Materials, Goods, Warehouses, Reasons). Readable by all signed-in users, writable only by Master Data Managers.
     * @path /raw_materials/{id}, /finished_goods/{id}, /warehouses/{id}, /waste_reasons/{id}
     * @allow get, list if isSignedIn()
     * @allow create, update, delete if isMasterDataManager()
     * @deny create if !isMasterDataManager()
     * @principle Role-based CRUD with public read for internal users.
     */
    match /raw_materials/{materialId} {
      allow get, list: if isSignedIn();
      allow create: if isMasterDataManager();
      allow update, delete: if resource != null && isMasterDataManager();
    }

    match /finished_goods/{finishedGoodId} {
      allow get, list: if isSignedIn();
      allow create: if isMasterDataManager();
      allow update, delete: if resource != null && isMasterDataManager();

      /**
       * @description Bill of Materials versions. Linked to finished goods.
       * @path /finished_goods/{finishedGoodId}/bom_versions/{bomVersionId}
       */
      match /bom_versions/{bomVersionId} {
        allow get, list: if isSignedIn();
        allow create: if isMasterDataManager();
        allow update, delete: if resource != null && isMasterDataManager();
      }
    }

    match /warehouses/{warehouseId} {
      allow get, list: if isSignedIn();
      allow create: if isMasterDataManager();
      allow update, delete: if resource != null && isMasterDataManager();

      /**
       * @description Stock transactions within a warehouse. Records movements.
       * @path /warehouses/{warehouseId}/stock_transactions/{transactionId}
       */
      match /stock_transactions/{transactionId} {
        allow get, list: if isInventoryManager() || isProductionOperator() || isSignedIn();
        allow create: if (isInventoryManager() || isProductionOperator()) && request.resource.data.userId == request.auth.uid;
        allow update, delete: if resource != null && isInventoryManager();
      }
    }

    match /waste_reasons/{reasonId} {
      allow get, list: if isSignedIn();
      allow create: if isMasterDataManager();
      allow update, delete: if resource != null && isMasterDataManager();
    }

    /**
     * @description Production Order lifecycle management.
     * @path /production_orders/{productionOrderId}
     * @allow create if isProductionManager()
     * @allow update if isProductionManager() or isProductionOperator()
     * @principle Operational role-based access for workflow management.
     */
    match /production_orders/{productionOrderId} {
      // Relaxed read permissions for prototyping: allow all signed-in users to list/get
      allow get, list: if isSignedIn();
      allow create: if isProductionManager() || isSignedIn(); // Allow create for demo purposes
      allow update: if resource != null && (isProductionManager() || isProductionOperator() || isSignedIn());
      allow delete: if resource != null && (isProductionManager() || isAdmin());

      /**
       * @description Records for consumption and output. Operators log these, Managers view them.
       */
      match /consumption_records/{recordId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if resource != null && (isProductionManager() || isAdmin());
      }

      match /output_records/{recordId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if resource != null && (isProductionManager() || isAdmin());
      }

      /**
       * @description System-generated variances and AI insights. Read-only for production staff.
       */
      match /variances/{varianceId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isAdmin(); // Only Admin for testing
      }

      match /insights/{insightId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isAdmin(); // Only Admin for testing
      }
    }
  }
}