
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /appSettings/global {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /roles_admin/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid);
      allow list: if isSignedIn();
    }

    match /system_logs/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    // Master Data Collections
    match /raw_materials/{id} {
      allow read, write: if isSignedIn();
    }
    match /finished_goods/{id} {
      allow read, write: if isSignedIn();
      
      match /price_rules/{ruleId} {
        allow read, write: if isSignedIn();
      }
      match /bom_versions/{bomId} {
        allow read, write: if isSignedIn();
      }
    }
    
    match /customers/{id} {
      allow read, write: if isSignedIn();
    }
    match /outlets/{id} {
      allow read, write: if isSignedIn();
    }
    match /warehouses/{id} {
      allow read, write: if isSignedIn();
      
      match /stock_transactions/{txnId} {
        allow read, write: if isSignedIn();
      }
    }

    match /invoices/{id} {
      allow read, write: if isSignedIn();
    }
    match /outlet_sales/{id} {
      allow read, write: if isSignedIn();
    }
    match /expenses/{id} {
      allow read, write: if isSignedIn();
    }
    match /production_orders/{id} {
      allow read, write: if isSignedIn();
      
      match /consumption_records/{recId} {
        allow read, write: if isSignedIn();
      }
    }
    match /waste_reasons/{id} {
      allow read, write: if isSignedIn();
    }
    match /stock_transfers/{id} {
      allow read, write: if isSignedIn();
    }
  }
}
