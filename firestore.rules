
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /appSettings/global {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /roles_admin/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid);
      allow list: if isSignedIn();
    }

    match /{path=**}/price_rules/{ruleId} {
      allow read, write: if isSignedIn();
    }

    match /{path=**}/bom_versions/{bomId} {
      allow read, write: if isSignedIn();
    }

    match /finished_goods/{productId} {
      allow read, write: if isSignedIn();
    }

    match /raw_materials/{materialId} {
      allow read, write: if isSignedIn();
    }

    match /customers/{customerId} {
      allow read, write: if isSignedIn();
    }

    match /outlets/{outletId} {
      allow read, write: if isSignedIn();
    }

    match /invoices/{invoiceId} {
      allow read, write: if isSignedIn();
    }

    match /outlet_sales/{saleId} {
      allow read, write: if isSignedIn();
    }

    match /expenses/{expenseId} {
      allow read, write: if isSignedIn();
    }

    match /warehouses/{warehouseId} {
      allow read, write: if isSignedIn();
    }

    match /production_orders/{orderId} {
      allow read, write: if isSignedIn();
    }

    match /waste_reasons/{reasonId} {
      allow read, write: if isSignedIn();
    }

    match /stock_transfers/{transferId} {
      allow read, write: if isSignedIn();
    }
  }
}
